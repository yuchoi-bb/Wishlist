<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) OS-level auto backup / device-transfer rules. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="wishlist.db" />
        <include domain="database" path="wishlist.db-wal" />
        <include domain="database" path="wishlist.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="wishlist.db" />
        <include domain="database" path="wishlist.db-wal" />
        <include domain="database" path="wishlist.db-shm" />
    </device-transfer>
</data-extraction-rules>
