<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Ground for both adaptive icons. minSdk is 26, so mipmap-anydpi-v26 always wins and this is
      the icon's background on every device the app runs on.

      The mark is cream rather than the navy it started as, which is what lets this red go deep:
      pairing them measures 7.3:1, where navy on any true red stayed under the 3:1 a shape needs to
      keep its edges and the eagle turned to mush at 48px. Change one of the two and check the
      other — the legacy ic_launcher*.png bitmaps carry the same pair baked in and have to follow,
      even though nothing renders them at this minSdk.
    -->
    <color name="ic_launcher_background">#8E2420</color>
</resources>
