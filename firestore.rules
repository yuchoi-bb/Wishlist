rules_version = '2';

// Paste this into Firebase Console > Firestore Database > Rules (or deploy with the Firebase CLI).
// Each signed-in user can only read/write their own subtree, so one person's items are never
// visible to another Google account. The wildcard covers everything under users/{userId} —
// wishlist_items and settings/categoryColors today, and anything added later — under the same
// owner-only condition.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
