rules_version = '2';

// Paste this into Firebase Console > Firestore Database > Rules (or deploy with the Firebase CLI).
// Each signed-in user can only read/write their own subtree, so one person's items are never
// visible to another Google account.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/wishlist_items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
